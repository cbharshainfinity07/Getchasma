# ---------------------------------------------------------------------------
# GetChasma API configuration. Copy to backend/.env and fill in real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5001

# REQUIRED in production: long random string (min 32 chars) used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=7

# First admin account — only used when no admin exists yet. Change the password from the dashboard afterwards.
ADMIN_EMAIL=admin@getchasma.com
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin

# Storage (paths are relative to backend/)
DATABASE_FILE=data/getchasma.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Allowed browser origins for CORS (comma separated). The Vite dev server proxies /api so this is rarely needed.
CORS_ORIGINS=http://localhost:5173

# Razorpay (optional). Online payments stay disabled until both keys are set.
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
